# Get a free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional: SMTP for anonymous email sending
# Without these, emails get "queued" in demo mode (still shows the preview)
# For quick setup: use a throwaway Gmail + App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_throwaway_email@gmail.com
SMTP_PASS=your_app_password

# Optional: override the LLM model if Groq retires this one
# GROQ_MODEL=openai/gpt-oss-20b
